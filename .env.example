# ==========================================
# VARIÁVEIS DE AMBIENTE - FLUXO
# Produção: Supabase Cloud + Vercel
# ==========================================
# IMPORTANTE:
# - Copie este arquivo para .env.local para desenvolvimento local.
# - Na Vercel, preencha essas variáveis em Settings > Environment Variables.
# - NUNCA utilize prefixo NEXT_PUBLIC_ para chaves secretas.

# URL do projeto no Supabase Cloud (Ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable Key pública do Supabase Cloud (ex-anon key, segura no browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL oficial da sua aplicação (Ex: http://localhost:4000 em dev ou https://fluxo.vercel.app em prod)
NEXT_PUBLIC_SITE_URL=

# Chave secreta exclusiva do servidor (Secret / Service Role Key)
# Obrigatória para operações administrativas (Admin API, convites, promover admin)
# NUNCA colocar no frontend!
SUPABASE_SECRET_KEY=
